# Required: create a bot with @BotFather. This is a placeholder, never a real token.
TELEGRAM_BOT_TOKEN=replace_with_bot_token
# Required: comma-separated numeric Telegram user IDs.
ALLOWED_USER_IDS=111111111,222222222

# Required: qBittorrent Web API reachable from the bot container.
QBITTORRENT_URL=http://host.docker.internal:8080
QBITTORRENT_USERNAME=replace_with_qbittorrent_username
QBITTORRENT_PASSWORD=replace_with_qbittorrent_password

# Application persistence and log locations inside the container.
DATABASE_PATH=/app/data/bot.sqlite3
LOG_PATH=/app/logs/bot.log
HEALTH_FILE=/app/data/healthy
HEALTH_MAX_AGE_SECONDS=180
LOG_LEVEL=INFO
TZ=Europe/Rome

# qBittorrent paths. They must match paths visible to qBittorrent.
DEFAULT_SAVE_PATH=/downloads
CATEGORY_FILM_PATH=/downloads/movies
CATEGORY_SERIES_PATH=/downloads/tv
CATEGORY_MUSIC_PATH=/downloads/music
CATEGORY_OTHER_PATH=/downloads/other
# Path mounted in the bot container, used only to measure free space.
DISK_CHECK_PATH=/downloads
MEDIA_ROOT_HOST=./downloads

# Limits and scheduling. Zero speed means unlimited.
MAX_TORRENT_SIZE_GB=100
MAX_TORRENT_FILE_MB=20
MAX_ACTIVE_DOWNLOADS=3
DOWNLOAD_LIMIT_KIB=0
UPLOAD_LIMIT_KIB=0
NIGHT_MODE_START=23:00
NIGHT_MODE_END=07:00
NIGHT_DOWNLOAD_LIMIT_KIB=2048
NIGHT_UPLOAD_LIMIT_KIB=512
MONITOR_INTERVAL_SECONDS=60
PERSISTENT_ERROR_CHECKS=3
TORRENT_PAGE_SIZE=8

# Network, abuse prevention, and content filtering.
NETWORK_TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=3
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=60
BUTTON_DEBOUNCE_SECONDS=3
UNAUTHORIZED_REPLY=false
BLOCKED_PATTERNS=.exe,.scr

# Optional Plex integration. Leave all four values empty to disable it.
PLEX_URL=
PLEX_TOKEN=
PLEX_MOVIE_SECTION_ID=
PLEX_SERIES_SECTION_ID=

# Docker runtime identity. Match the owner of ./data and ./logs.
PUID=1000
PGID=1000

[Unit]
Description=Bot Telegram per qBittorrent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=qbittorrent-bot
Group=qbittorrent-bot
WorkingDirectory=/opt/qbittorrent-telegram
EnvironmentFile=/etc/qbittorrent-telegram.env
ExecStart=/usr/bin/python3 /opt/qbittorrent-telegram/bot.py
Restart=on-failure
RestartSec=10s
TimeoutStopSec=40s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/qbittorrent-telegram /var/log/qbittorrent-telegram

[Install]
WantedBy=multi-user.target
